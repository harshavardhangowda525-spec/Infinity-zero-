# ─── AI providers (all optional, all have free tiers) ─────────────────────────
# Tried in order; if one is missing, rate-limited, errors or returns bad JSON,
# the next one takes over. With none set, a clearly labelled demo analyzer runs.
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (uses a ":free" model)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# Optional overrides
# AI_PROVIDER_ORDER=groq,gemini,openrouter,cerebras
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# CEREBRAS_MODEL=llama-3.3-70b

# ─── Supabase (optional — without it data stays in the browser, labelled demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; used for feedback inserts + passcode founder reads

# ─── Founder dashboard protection ─────────────────────────────────────────────
# Strongly recommended for any public deployment.
FOUNDER_PASSCODE=
